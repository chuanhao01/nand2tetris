/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * of 512 pixels each (indexed 0..511, left to right). The top left pixel on
 * the screen is indexed (0,0).
 */
class Screen {
    static int screen_base_address;
    static bool color;

    /** Initializes the Screen. */
    function void init() {
        let screen_base_address = 16384;
        let color = true;
        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var int i;
        let i = 0;
        // 512 * 256 / 16
        while (i < 8192){
            do Memory.poke(screen_base_address + i, 0);
        }
        return;
    }

    /** Sets the current color, to be used for all subsequent drawXXX commands.
     *  Black is represented by true, white by false. */
    function void setColor(boolean b) {
        let color = b;
        return;
    }

    /** Draws the (x,y) pixel, using the current color. */
    function void drawPixel(int x, int y) {
        var int addr, v, bm; // RAM addr

        let addr = screen_base_address + (y * 32) + (x / 16);
        let v = Memory.peek(addr);
        let bm = Math.two_power_n(Math.mod(x, 16));
        if (color){
            do Memory.poke(addr, v | bm);
        } else {
            do Memory.poke(addr, v & (~bm));
        }
        return;
    }

    /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int dx, dy, dir_x, dir_y, ady_minus_bdx;
        let ady_minus_bdx = 0;
        let dx = x2 - x1;
        let dy = y2 - y1;
        if (dx > 0) {
            let dir_x = 1;
        } else {
            let dir_x = -1;
        }
        if (dy > 0){
            let dir_y = 1;
        } else {
            let dir_y = -1;
        }
        if (dx = 0){
            // Special case for vertical lines
            do Screen.drawPixel(x1, y1);
            while(~(y2 = y1)){
                let y1 = y1 + dir_y;
                do Screen.drawPixel(x1, y1);
            }
            return;
        }
        if (dy = 0){
            // Special case for horizontal lines
            do Screen.drawPixel(x1, y1);
            while(~(x2 = x1)){
                let x1 = x1 + dir_x;
                do Screen.drawPixel(x1, y1);
            }
            return;
        }
        do Screen.drawPixel(x1, y1);
        while(~(x2 = x1) | ~(y2 = y1)){
            if(ady_minus_bdx < 0){
                let x1 = x1 + dir_x;
                let ady_minus_bdx = ady_minus_bdx + (dir_x * dy);
            } else {
                let y1 = y1 + dir_y;
                let ady_minus_bdx = ady_minus_bdx - (dir_y * dx);
            }
            do Screen.drawPixel(x1, y1);
        }
        return;

    }

    /** Draws a filled rectangle whose top left corner is (x1, y1)
     * and bottom right corner is (x2,y2), using the current color. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        do Screen.drawLine(x1, y1, x1, y2);
        while((x2 + 1) > x1){
            let x1 = x1 + 1;
            do Screen.drawLine(x1, y1, x1, y2);
        }
        return;
    }

    function void drawEmptyRectangle(int x1, int y1, int x2, int y2) {
        do Screen.drawLine(x1, y1, x1, y2);
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x2, y1, x2, y2);
        do Screen.drawLine(x1, y2, x2, y2);
        return;
    }

    /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
    function void drawCircle(int x, int y, int r) {
    }
}
