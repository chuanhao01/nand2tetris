class Main {
    /** Performs various mathematical operations, using calls to the Math class methods. */
    function void main() {
        var Array a, b, c;
        let a = Array.new(3);
        let b = Array.new(3);
        let c = Array.new(500);

        do a.dispose();
        do b.dispose();

        let b = Array.new(3);

        do c.dispose();
        do b.dispose();
        return;
    }

}
